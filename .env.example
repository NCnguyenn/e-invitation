NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Public HTTPS origin used only by the server to build /invite/{token}. No trailing slash, port, path, or localhost.
# Do not use APP_BASE_URL or the request Origin as a second source for invite links.
SITE_URL=
# Required for integration/auth E2E writes; URL must match supabase/test-project.json.
SUPABASE_TARGET=
# Local tests only: stub requires NODE_ENV=development/test and the pinned Supabase test URL.
# Netlify/production rejects stub. Set brevo or leave unset for real sending.
EMAIL_TRANSPORT=
