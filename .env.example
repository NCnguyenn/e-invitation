NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Public HTTPS origin used only by the server to build /invite/{token}. No trailing slash, port, path, or localhost.
# Do not use APP_BASE_URL or the request Origin as a second source for invite links.
SITE_URL=
# Required to enable the local stub transport; must match supabase/test-project.json.
SUPABASE_TARGET=
# Stub is local-only and requires the pinned test Supabase project. Hosting rejects stub.
# Set brevo or leave unset for real sending.
EMAIL_TRANSPORT=
# Optional Supabase Management API credentials for /system-admin disk and API metrics
SUPABASE_MANAGEMENT_TOKEN=
SUPABASE_PROJECT_REF=
# Optional metrics scope override: production, staging, or local
METRICS_ENVIRONMENT=
SUPABASE_ORG_SLUG=
